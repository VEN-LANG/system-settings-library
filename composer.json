{
    "name": "venom/system-settings",
    "description": "A laravel module that will handle system settings for your application.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Venom\\SystemSettings\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Venom\\SystemSettings\\Providers\\SystemSettingsServiceProvider"
            ]
        }
    },
    "require": {
        "illuminate/support": "^11 | ^12 | ^13",
        "illuminate/database": "^11 | ^12 | ^13",
        "illuminate/queue": "^11 | ^12 | ^13",
        "illuminate/bus": "^11 | ^12 | ^13",
        "illuminate/contracts": "^11 | ^12 | ^13"
    }
}
